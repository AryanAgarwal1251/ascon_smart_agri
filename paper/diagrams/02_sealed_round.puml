@startuml sealed_round
' One federated round, showing the associated data on every frame.
' render at 2x so the raster export is print-resolution at column width
scale 2
skinparam defaultFontName Helvetica
skinparam defaultFontSize 20
skinparam shadowing false
skinparam ParticipantBackgroundColor #eef4fc
skinparam ParticipantBorderColor #2a78d6
skinparam ArrowColor #52514e
skinparam NoteBackgroundColor #fdf6ec
skinparam NoteBorderColor #eb6834

title One sealed federated round (round t)

participant "Gateway k\n(local GRU)" as C
participant "Aggregator\n(master GRU)" as A

== Local training ==
C -> C : theta_k <- LocalTrain(theta_t, S_k, E)

== Upload, sealed ==
C -> C : nu <- CSPRNG(128 bits)
C -> C : a = <k, t, "up", schema>
C -> A : Seal(k_up_k, nu, a, safetensors(theta_k, n_k))

A -> A : m <- Open(k_up_k, frame)
alt m = bottom
  A -> A : <b>reject; never applied</b>
else m valid
  A -> A : accept (theta_k, n_k)
end

== Aggregation ==
A -> A : theta_{t+1} <- sum_k (n_k / sum_j n_j) * theta_k

== Download, sealed ==
A -> A : nu' <- CSPRNG(128 bits)
A -> A : a' = <k, t, "down", schema>
A -> C : Seal(k_down_k, nu', a', safetensors(theta_{t+1}))
C -> C : theta <- Open(k_down_k, frame)

@enduml
