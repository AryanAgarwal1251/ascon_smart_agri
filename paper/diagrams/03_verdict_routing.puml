@startuml verdict_routing
' The runtime path a single reading takes, and where it can end.
' render at 2x so the raster export is print-resolution at column width
scale 2
skinparam defaultFontName Helvetica
skinparam defaultFontSize 20
skinparam shadowing false
skinparam ArrowColor #52514e
skinparam ActivityBackgroundColor #eef4fc
skinparam ActivityBorderColor #2a78d6
skinparam ActivityDiamondBackgroundColor #fdf6ec
skinparam ActivityDiamondBorderColor #eb6834
skinparam NoteBackgroundColor #fdf6ec
skinparam NoteBorderColor #eb6834

title Runtime: one sensor reading

start
:MQTT reading arrives\n{deviceId, temperature, soilMoisture, seq};
:replay guard checks monotonic seq;
if (accepted?) then (no)
  :drop;
  stop
endif

:feature-provenance adapter;

:append to this device's window buffer;
if (buffer has W = 16 records?) then (no)
  :buffering;
  stop
endif

:local GRU classifies the window;

if (verdict benign?) then (yes)
  :encrypt and send over TLS;
  :cloud receiver accepts;
  stop
else (no)
  :raise local alert;
  stop
endif

@enduml
