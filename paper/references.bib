% Cross-dataset generalisation: the finding our negative result replicates
% ---------------------------------------------------------------------------

@misc{layeghy2022generalisability,
  author       = {Layeghy, Siamak and Portmann, Marius},
  title        = {On Generalisability of Machine Learning-based Network Intrusion Detection Systems},
  howpublished = {arXiv:2205.04112},
  year         = {2022},
  url          = {https://arxiv.org/abs/2205.04112}
}
% CLAIM WE MAKE, read from the paper: four NIDS corpora converted to ONE standardised 43-feature
% NetFlow schema; within-dataset 76-99% F1; cross-dataset 56.28% average decay for supervised
% models, sometimes near 0% F1; "none of the considered models is able to generalise over all
% studied datasets"; Extra Trees 94.83% UNSW-NB15->BoT-IoT against 4.90% reversed; SHAP attributes
% within-dataset performance to shortcut features that do not transfer.
% WHY IT MATTERS TO US: it removes feature-schema mismatch as an explanation, so our own
% cross-corpus collapse is a replication rather than a defect.
% VERIFY: author list and whether a peer-reviewed version superseded the preprint.

@article{dataset_centric_fl_ids,
  title   = {Dataset-centric evaluation of federated intrusion detection models in IoT networks},
  journal = {Scientific Reports},
  year    = {2025},
  url     = {https://www.nature.com/articles/s41598-025-32567-w}
}
% CLAIM WE MAKE, read from the article: federated IDS over Edge-IIoTset, CIC-IoT2023 and
% TII-SSRC-23; in-domain 96.5 / 95.2 / 93.0 % macro-F1; up to 30 percentage-point macro-F1 loss
% cross-dataset; combined multi-dataset federated training reaches ~90% macro-F1 across corpora;
% FedNova cuts communication 15-25% against FedAvg; Transformer beats LSTM by 1-2 points.
% WHY IT MATTERS TO US: it is the closest published work, and it recommends exactly the
% mixed-farm design we built independently.
% VERIFY: author list, volume and article number.

@misc{galal2026provenance,
  author       = {Galal, Mostafa M.},
  title        = {Provenance, Not Behaviour: A Serialisation Artifact in {Edge-IIoTset} and a
                  Leakage-Free Benchmark for Precision-Agriculture Intrusion Detection},
  howpublished = {arXiv:2608.15761},
  year         = {2026},
  url          = {https://arxiv.org/abs/2608.15761}
}
% CLAIM WE MAKE, read from the abstract: four of the seven columns Edge-IIoTset's official
% preprocessing recipe tells researchers to one-hot encode separate attack from normal with
% accuracy 1.0000 on their own, through the placeholder spelling "0" against "0.0"; five of six
% standard classifiers reach 1.0000 +/- 0.0000; under a corrected protocol the strongest model
% settles at 0.9503 +/- 0.0011. The paper rebuilds the benchmark from raw captures as AgriEdge:
% 1,276,122 rows, five devices with full attribution, no column separating classes above 0.0288.
% A leave-one-device-out sweep puts the generalisation boundary at the perception/actuation layer,
% where random forest falls 0.9988 -> 0.5083 balanced accuracy; non-IID federated partitioning
% costs at most 0.0037 macro-F1.
% WHY IT MATTERS TO US: (i) it is the source for the placeholder artefact our characterisation
% checks for, and (ii) leave-one-device-out is the generalisation test we should be running.

