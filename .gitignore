# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Data (CICIoT2023 is large and must not be committed) ---
/data/
*.csv
*.parquet
!tests/**/*.csv          # small fixture CSVs used by tests may be committed

# --- Run artifacts (models, figures) ---
# Bulk output stays out of git, but the JSON manifests and phase reports are PROVENANCE, not
# output: Section III-I4 requires that no headline number is reported without a manifest, and
# a manifest that exists only on the machine that produced it cannot substantiate the figures
# quoted in CHANGELOG.md. Each manifest records the git commit it belongs to, so the repo is
# exactly where it is useful. All of them together are ~200 KB.
# NB: the pattern is "artifacts/*", not "artifacts/" -- git never descends into an excluded
# DIRECTORY, so a "!" re-include under one is silently ignored.
artifacts/*
!artifacts/manifest_*.json
!artifacts/phase*_report*.json
!artifacts/phase*_feature_selection.json
*.safetensors
*.pt
*.ckpt

# --- Key material: NEVER commit (III-J3 ethics). Demo keys must be labelled as such. ---
*.key
*.pem
secrets/
keys/
*.demo.key            # even labelled demo keys stay out of version control

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
